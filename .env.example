# ── Chronos Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Required ───────────────────────────────────────────────────────────
# Backend URL (used for CORS, OAuth redirects)
BACKEND_URL=https://chronos-backend-xxxxx.run.app

# Frontend URL (used for CORS)
FRONTEND_URL=https://chronos-frontend-xxxxx.run.app

# Google OAuth credentials (for Google Calendar sync)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Cloud API key (for Voice Daemon STT + TTS)
GOOGLE_API_KEY=your-api-key

# Gemini API key fallback (if not configured via UI)
GEMINI_API_KEY=your-gemini-key

# ── Optional ───────────────────────────────────────────────────────────
# Override SQLite database path
# SQLITE_DB_PATH=/custom/path/chronos.db

# Next.js build-time backend URL (frontend only)
# NEXT_PUBLIC_API_URL=https://chronos-backend-xxxxx.run.app

# Google Cloud Storage bucket for data persistence
# GCS_BUCKET_NAME=chronos-backup-bucket
